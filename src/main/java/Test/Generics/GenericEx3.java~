        // параметизируем чтобы он работал с конкретными типом который во время выполнения будем знаь , так что применять <?> не типобезопасно
        public static <K, V> HashMap  <K, V> newHashMap(List<? extends K> keys, List<? extends V> values) {
        //напишите тут ваш код

            HashMap<K,V> map;

            if (keys.size() != values.size()) {  // првоеряем размер ключей и значений
                throw new IllegalArgumentException();
            }

            map = new HashMap<>();
            for (int i = 0; i < keys.size(); i++) {
                map.put(keys.get(i), values.get(i));
            }

            return map;

